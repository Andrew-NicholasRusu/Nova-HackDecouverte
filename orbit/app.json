{
  "expo": {
    "name": "Orbit",
    "slug": "orbit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orbit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.nova.orbit",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#912338",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nova.orbit"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png",
      "name": "Orbit",
      "shortName": "Orbit",
      "themeColor": "#912338",
      "backgroundColor": "#0F1320",
      "description": "Your university, connected. Schedule, friends, live campus conditions and indoor directions for Concordia students."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1320",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#0F1320"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Your university, connected. Schedule, friends, live campus conditions and indoor directions for Concordia students.",
    "backgroundColor": "#0F1320"
  }
}
