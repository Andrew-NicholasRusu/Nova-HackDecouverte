# Copy to .env.local (gitignored) and fill in.

# Concordia Open Data — server-only: do NOT prefix with EXPO_PUBLIC_.
# Get these from opendata.concordia.ca > My Applications > your application.
CONCORDIA_API_USER=
CONCORDIA_API_KEY=

# Supabase — public by design (RLS protects data). Use the PUBLISHABLE/anon key,
# never the service_role / sb_secret_ key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
